generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  STORE_OWNER
  CASHIER
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  SUSPENDED
}

enum StampSource {
  cashier
  nfc
}

enum StampLedgerType {
  STAMP
  REDEEM
  ADJUST
  POINT_EARN
  POINT_REDEEM
  DISCOUNT_USE
  EVENT_CHECKIN
  STAFF_REDEEM
  REFERRAL
  MEMBERSHIP_USE
  CASHBACK_EARN
  CASHBACK_REDEEM
}

enum PassPlatform {
  APPLE
  GOOGLE
}

/// Apple Wallet kilit ekranı bildirimi — pass indirilirken hangi olay için metin üretilecek
enum PassNotifyKind {
  STAMP
  REDEEM
  BIRTHDAY
}

enum PushPlatform {
  IOS
  ANDROID
}

enum OwnerPushKind {
  ACCOUNT
  DAILY_SUMMARY
  WEEKLY_SUMMARY
}

/// Sadakat program tipi
enum ProgramType {
  STAMP_CARD
  MULTI_STAMP
  POINT_CARD
  DISCOUNT_CARD
  EVENT_CARD
  STAFF_CARD
  MEMBERSHIP_CARD
  CASHBACK_CARD
}

/// SaaS abonelik paketi — kota, özellik ve admin menü anahtarları
model SubscriptionPlan {
  id                  String   @id @default(cuid())
  code                String   @unique
  labelTr             String
  labelEn             String?
  priceTry            Int      @default(0)
  maxPrograms         Int      @default(1)
  allowedProgramTypes Json
  maxByType           Json     @default("{}")
  features            Json
  menuKeys            Json
  maxBranches         Int      @default(1)
  maxMenuCategories   Int      @default(0)
  maxMenuItems        Int      @default(0)
  maxMenuTables       Int      @default(0)
  sortOrder           Int      @default(0)
  isActive            Boolean  @default(true)
  isPublic            Boolean  @default(true)
  badgeTr             String?
  badgeEn             String?
  noteTr              String?
  noteEn              String?
  includesTr          Json     @default("[]")
  includesEn          Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  tenants Tenant[]

  @@index([isActive, isPublic, sortOrder])
}

model Tenant {
  id                      String             @id @default(cuid())
  name                    String
  slug                    String             @unique
  logoUrl                 String?
  primaryColor            String?
  /// Apple logoText / kart üst yazısı (boşsa name)
  logoText                String?
  foregroundColor         String?
  labelColor              String?
  /// Wallet kartı arka yüz alanları
  passDescription         String?
  passHowItWorks          String?
  passTerms               String?
  passLocations           String?
  passHours               String?
  passWebsiteUrl          String?
  passPhone               String?
  stampFieldLabel         String?
  rewardFieldLabel        String?
  /// Ön yüz durum alanı etiketi (varsayılan DURUM)
  statusFieldLabel        String?
  /// Alt satır duyuru etiketi (varsayılan NOTICE / DUYURU)
  broadcastFieldLabel     String?
  /// Duyuru yokken gösterilecek metin
  broadcastEmptyText      String?
  /// Ön yüz alan görünürlüğü (owner)
  showStampField          Boolean            @default(true)
  showRewardField         Boolean            @default(true)
  showStatusField         Boolean            @default(true)
  showBroadcastField      Boolean            @default(true)
  /// Müşteri kayıt / Wallet öncesi toplanacak alanlar (owner aç-kapa)
  collectCustomerName     Boolean            @default(false)
  collectCustomerBirthday Boolean            @default(false)
  /// Doğum günü otomatik Wallet bildirimi
  birthdayGiftEnabled     Boolean            @default(false)
  birthdayMessage         String?
  /// SMS davet / Wallet ekleme sayfası metinleri (boşsa varsayılan)
  inviteHeadline          String?
  inviteSubtitle          String?
  inviteCtaHint           String?
  /// Sayfa arka plan rengi (#RRGGBB); boşsa koyu varsayılan
  inviteBgColor           String?
  /// Kart arka planı (#RRGGBB); boşsa primaryColor
  inviteCardColor         String?
  /// Damga altındaki durum metni
  inviteStatusText        String?
  /// Apple / Google buton etiketleri
  inviteAppleBtnLabel     String?
  inviteGoogleBtnLabel    String?
  /// Profil formu başlığı
  inviteFormTitle         String?
  /// Alt bilgi / kısa KVKK notu
  inviteLegalText         String?
  inviteLayout           Json?
  /// Politikalar: [{ title, body }] — KVKK, Gizlilik vb.
  invitePolicies          Json?
  /// Ödül hazır metni
  rewardReadyText         String?
  /// Kalan damga şablonu — {remaining} yer tutucu
  stampsRemainingTemplate String?
  /// Stack’te görünen header etiketi (boşsa header yok); değer damga sayısı
  headerFieldLabel        String?
  /// COFFEE | DESSERT | STAR | HEART | DONUT | CUSTOM
  stampTheme              String             @default("COFFEE")
  stampIconFilledUrl      String?
  stampIconEmptyUrl       String?
  /// Damga şeridi kenar boşluğu: TIGHT | NORMAL | WIDE
  stampInset              String             @default("NORMAL")
  /// Arka yüz alan etiketleri (boşsa varsayılan TR etiket)
  passDescriptionLabel    String?
  passHowItWorksLabel     String?
  passTermsLabel          String?
  passLocationsLabel      String?
  passHoursLabel          String?
  passWebsiteLabel        String?
  passPhoneLabel          String?
  /// Serbest arka yüz satırları
  passExtra1Label         String?
  passExtra1Value         String?
  passExtra2Label         String?
  passExtra2Value         String?
  passExtra3Label         String?
  passExtra3Value         String?
  /// Lock-screen / bildirim ikonu (icon.png)
  notifyIconUrl           String?
  /// changeMessage şablonları — %@ yeni değer
  stampChangeMessage      String?
  rewardChangeMessage     String?
  statusChangeMessage     String?
  headerChangeMessage     String?
  redeemChangeMessage     String?
  /// QR | PDF417 | AZTEC | CODE128
  barcodeFormat           String             @default("QR")
  /// Owner’dan anlık duyuru (Wallet changeMessage)
  passBroadcastMessage    String?
  passBroadcastAt         DateTime?
  planCode                String             @default("cafe")
  plan                    SubscriptionPlan   @relation(fields: [planCode], references: [code])
  /// Aylık paket ücreti (TL, kuruşsuz tam lira)
  planPriceTry            Int                @default(990)
  subscriptionStatus      SubscriptionStatus @default(TRIAL)
  subscriptionActivatedAt DateTime?
  /// Mevcut fatura dönemi / erişim bitişi
  subscriptionPeriodEndsAt DateTime?
  /// Kullanıcı abonelik iptali talebi
  subscriptionCancelledAt DateTime?
  /// İptal sonrası giriş erişimi sonu (kalan gün)
  subscriptionAccessEndsAt DateTime?
  /// Hesap silme talebi: 14 gün sonra kalıcı silinir, bu sürede iptal edilebilir
  deletionRequestedAt      DateTime?
  deletionScheduledAt      DateTime?
  /// Deneme bitişi hatırlatmasında son gönderilen eşik (3, 1, 0 gün kala)
  trialReminderDay         Int?
  /// Marka düzeyi kart varsayılanları: Alanlar (header) ve Kilit ekranı (konum, tarih, bayraklar)
  walletDefaults           Json?
  deletionReason           String?
  deletionNote             String?
  /// Hesap askıya alındı
  subscriptionSuspendedAt DateTime?
  /// Askıda yeniden açılabilir pencere (90 gün)
  subscriptionSuspendUntil DateTime?
  /// Askıya alınırken dondurulan kalan abonelik günü
  subscriptionFrozenDaysRemaining Int?
  /// PassMarket: işletme Marketplace vitrininde listelensin mi
  marketplaceListingEnabled Boolean           @default(false)
  /// PassMarket: satın alınan MP plan slug (vitrin / buyume / isletme-pro)
  marketplacePlanSlug     String?
  isActive                Boolean            @default(true)
  /// QR menü tasarım ailesi: editorial | catalog | showcase
  menuThemePreset         String             @default("editorial")
  /// QR menü özelleştirme JSON'u (hero, nav, kart, stil, sayfa)
  menuThemeConfig         Json?
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  users       User[]
  customers   Customer[]
  rewardRule  RewardRule?
  loyaltyPrograms LoyaltyProgram[]
  stampLedger StampLedger[]
  passes      Pass[]
  broadcastLogs BroadcastLog[]
  campaigns   Campaign[]
  branches    Branch[]
  nfcDevices  NfcDevice[]
  segments    Segment[]
  vipTiers    VipTier[]
  referralCodes ReferralCode[]
  posIntegrations PosIntegration[]
  emailTemplates EmailTemplate[]
  dailyMetrics DailyTenantMetrics[]
  branchDailyMetrics BranchDailyMetrics[]
  tenantApiKeys TenantApiKey[]
  giftCredits GiftCredit[]
  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  menuTables     MenuTable[]
  menuThemes     MenuTheme[]
  menuFeedback   MenuFeedback[]
  menuTags       MenuTag[]
  menuCatalogEntries MenuCatalogEntry[]

  @@index([isActive])
  @@index([subscriptionStatus])
}

/// Tenant’ın kaydettiği QR menü temaları
model MenuTheme {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  /// editorial | catalog | showcase
  preset    String   @default("editorial")
  document  Json
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, isActive])
}

/// Owner anlık duyuru geçmişi
model BroadcastLog {
  id        String   @id @default(cuid())
  tenantId  String
  message   String
  synced    Int      @default(0)
  devices   Int      @default(0)
  /// all | segment | vip
  audience  String   @default("all")
  audienceLabel String?
  targetCount Int?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
}

enum CampaignType {
  MULTIPLIER
  WIN_BACK
  SCHEDULED_BROADCAST
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

/// Tenant-wide promosyon / kampanya
model Campaign {
  id        String         @id @default(cuid())
  tenantId  String
  name      String
  type      CampaignType
  status    CampaignStatus @default(DRAFT)
  config    Json
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   CampaignRun[]

  @@index([tenantId, status])
  @@index([tenantId, type, status])
}

model CampaignRun {
  id         String   @id @default(cuid())
  campaignId String
  customerId String?
  status     String   @default("PENDING")
  metadata   Json?
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([customerId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role
  tenantId     String?
  branchId     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  refreshTokens   RefreshToken[]
  passwordResets  PasswordResetToken[]
  stampActions    StampLedger[] @relation("StampCreatedBy")
  ownerPushDevices OwnerPushDevice[]
  ownerPushPref    OwnerPushPref?
  ownerPushLogs    OwnerPushLog[]

  @@index([tenantId])
  @@index([role])
  @@index([branchId])
}

/// Owner mobil uygulama FCM cihaz kaydı
model OwnerPushDevice {
  id        String       @id @default(cuid())
  userId    String
  fcmToken  String       @unique
  platform  PushPlatform
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Owner push tercihi — kapalıysa hiçbir otomatik bildirim gitmez
model OwnerPushPref {
  userId    String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Günlük/haftalık özet tekrarını önler
model OwnerPushLog {
  id        String        @id @default(cuid())
  userId    String
  kind      OwnerPushKind
  dedupeKey String
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, dedupeKey])
  @@index([userId, createdAt])
}

/// Named permissions for RBAC checks (seeded; roles map in app code + this table for fine-grained flags)
model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String @id @default(cuid())
  role         Role
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([role])
}

model Customer {
  id                     String    @id @default(cuid())
  tenantId               String
  /// Legacy plaintext — migration sonrası null; yeni kayıtlarda kullanılmaz
  phone                  String?
  phoneHash              String?
  phoneEnc               String?
  phoneLast4             String?
  stampCount             Int       @default(0)
  rewardReady            Boolean   @default(false)
  /// Opsiyonel — owner collectCustomerName açıksa Wallet öncesi istenir
  displayName            String?
  /// Legacy plaintext e-posta — yeni kayıtlarda emailEnc kullanılır
  email                  String?
  emailHash              String?
  emailEnc               String?
  /// Personel kartı — normal kampanyalardan hariç
  isStaff                Boolean   @default(false)
  branchId               String?
  vipTierId              String?
  /// new | active | dormant | churn
  lifecycleStage         String    @default("new")
  smsOptOut              Boolean   @default(false)
  /// Opsiyonel — ay/gün (yıl tutulmaz; KVKK minimal)
  birthMonth             Int?
  birthDay               Int?
  /// Aynı yıl içinde tekrar doğum günü bildirimi gitmesin
  lastBirthdayNotifyYear Int?
  consentAt              DateTime?
  /// Hedefli bildirim (kart üstünde bu müşteriye özel duyuru); null → kafe geneli duyuru
  passNotice             String?
  passNoticeAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant      Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch      Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  vipTier     VipTier?          @relation(fields: [vipTierId], references: [id], onDelete: SetNull)
  stampLedger StampLedger[]
  passes      Pass[]
  customerPrograms CustomerProgram[]
  tags        CustomerTag[]
  notes       CustomerNote[]
  referralCodes ReferralCode[] @relation("Referrer")
  referralRedemptions ReferralRedemption[] @relation("Referee")
  socialRewardClaims SocialRewardClaim[]

  @@unique([tenantId, phoneHash])
  @@index([tenantId])
  @@index([phoneHash])
  @@index([tenantId, phoneLast4])
  @@index([tenantId, birthMonth, birthDay])
  @@index([tenantId, lifecycleStage])
  @@index([tenantId, isStaff])
}

model RewardRule {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  stampsRequired Int      @default(10)
  rewardLabel    String   @default("1 bedava kahve")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Tenant sadakat programı (RewardRule ile senkron)
model LoyaltyProgram {
  id         String      @id @default(cuid())
  tenantId   String
  type       ProgramType @default(STAMP_CARD)
  name       String      @default("Sadakat kartı")
  isActive   Boolean     @default(true)
  /// Ana program — damga akışı bu kayda sync edilir (tenant başına bir tane)
  isPrimary  Boolean     @default(true)
  /// null = eski tenant geneli; çok şubede her karta şube atanır
  branchId   String?
  config     Json        @default("{}")
  validFrom  DateTime?
  validUntil DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tiers            ProgramTier[]
  customerPrograms CustomerProgram[]
  stampLedger      StampLedger[]
  passes           Pass[]

  @@index([tenantId])
  @@index([tenantId, isPrimary])
  @@index([tenantId, isActive])
  @@index([tenantId, branchId])
}

model ProgramTier {
  id          String   @id @default(cuid())
  programId   String
  sortOrder   Int      @default(0)
  threshold   Int
  rewardLabel String
  redeemCost  Int
  /// MultiStamp lane kimliği
  laneId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  program LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@index([programId])
}

model CustomerProgram {
  id              String   @id @default(cuid())
  tenantId        String
  customerId      String
  programId       String
  balance         Int      @default(0)
  /// MultiStamp lane sayaçları — { coffee: 3, dessert: 1 }
  balances        Json?
  rewardReady     Boolean  @default(false)
  eligibleTierIds Json?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  program  LoyaltyProgram @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([customerId, programId])
  @@index([tenantId])
  @@index([programId])
  @@index([tenantId, rewardReady])
}

model StampLedger {
  id              String          @id @default(cuid())
  tenantId        String
  customerId      String
  type            StampLedgerType
  source          StampSource?
  createdByUserId String?
  branchId        String?
  note            String?
  /// İlişkili program (geriye dönük null)
  programId       String?
  /// Damga adedi / puan miktarı (varsayılan 1)
  amount          Int             @default(1)
  metadata        Json?
  createdAt       DateTime        @default(now())

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer  Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("StampCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  program   LoyaltyProgram? @relation(fields: [programId], references: [id], onDelete: SetNull)
  branch    Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([customerId, createdAt])
  @@index([createdByUserId])
  @@index([branchId, createdAt])
}

model Pass {
  id                   String       @id @default(cuid())
  tenantId             String
  customerId           String
  /// Kart başına ayrı Wallet pass
  programId            String?
  platform             PassPlatform
  externalId           String
  /// Apple PassKit authenticationToken (sent as Authorization: ApplePass …)
  authenticationToken  String?
  /// Bumped on each stamp/redeem so Wallet can poll updates
  contentVersion       Int              @default(0)
  /// Son push için bildirim türü (PassKit GET sonrası temizlenir)
  pendingNotifyKind    PassNotifyKind?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime     @updatedAt

  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer             Customer                  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  program              LoyaltyProgram?           @relation(fields: [programId], references: [id], onDelete: SetNull)
  appleRegistrations   AppleDeviceRegistration[]

  @@unique([platform, externalId])
  @@index([tenantId])
  @@index([customerId])
  @@index([programId])
}

/// Apple Wallet device push registrations (PassKit web service)
model AppleDeviceRegistration {
  id                      String   @id @default(cuid())
  deviceLibraryIdentifier String
  passTypeIdentifier      String
  pushToken               String
  passId                  String
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  pass Pass @relation(fields: [passId], references: [id], onDelete: Cascade)

  @@unique([deviceLibraryIdentifier, passId])
  @@index([passId])
  @@index([deviceLibraryIdentifier, passTypeIdentifier])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  /// Cihaz anahtarı = IP + tarayıcı bilgisinin hash'i. Aynı cihaz tek satır olur.
  deviceKey  String?
  ip         String?
  userAgent  String?
  lastUsedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@unique([userId, deviceKey])
}

/// Personel şifre sıfırlama (e-posta veya owner’ın paylaştığı link)
enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
  PASSWORD_CHANGE
  ACCOUNT_CANCEL
  ACCOUNT_DELETE
}

/// E-posta ile tek kullanımlık 6 haneli kod (kayıt doğrulama, şifre sıfırlama)
model EmailOtp {
  id         String     @id @default(cuid())
  email      String
  purpose    OtpPurpose
  codeHash   String
  attempts   Int        @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([email, purpose, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

/// Marketing site iletişim / demo talepleri
model ContactLead {
  id        String   @id @default(cuid())
  name      String
  cafe      String
  email     String
  phone     String?
  sector    String?
  message   String
  source    String   @default("contact")
  status    String   @default("NEW")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([email])
}

/// SMS gönderim + iletiMerkezi teslimat raporu (webhook / get-report)
model SmsMessage {
  id          String    @id @default(cuid())
  provider    String    @default("iletimerkezi")
  /// send-sms order.id == webhook packet_id
  orderId     String?
  /// webhook report.id (mesaj bazlı)
  reportId    String?   @unique
  toPhone     String
  body        String
  link        String?
  /// queued | sent | accepted | delivered | undelivered | failed
  status      String    @default("queued")
  error       String?
  providerRaw Json?
  sentAt      DateTime?
  statusAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([orderId])
  @@index([toPhone])
  @@index([status])
  @@index([createdAt])
}

/// Çoklu şube
model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]
  customers   Customer[]
  stampLedger StampLedger[]
  nfcDevices  NfcDevice[]
  loyaltyPrograms LoyaltyProgram[]
  branchDailyMetrics BranchDailyMetrics[]
  menuCategories MenuCategory[]
  menuTables     MenuTable[]

  @@index([tenantId])
  @@index([tenantId, isActive])
}

/// NFC tag / cihaz
model NfcDevice {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String?
  label     String
  tagUrl    String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch   Branch?       @relation(fields: [branchId], references: [id], onDelete: SetNull)
  tapEvents NfcTapEvent[]

  @@index([tenantId])
}

model NfcTapEvent {
  id         String   @id @default(cuid())
  tenantId   String
  deviceId   String?
  customerId String?
  status     String   @default("PENDING")
  metadata   Json?
  createdAt  DateTime @default(now())

  device NfcDevice? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([customerId])
}

/// CRM segment
model Segment {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  rules     Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model CustomerTag {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  tag        String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, tag])
  @@index([tenantId, tag])
}

model CustomerNote {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  authorId   String?
  body       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

/// VIP katmanları
model VipTier {
  id              String   @id @default(cuid())
  tenantId        String
  name            String
  minVisits       Int      @default(0)
  minSpendKurus   Int      @default(0)
  rateMultiplier  Float    @default(1)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customers Customer[]

  @@index([tenantId, sortOrder])
}

/// Referans programı
model ReferralCode {
  id           String   @id @default(cuid())
  tenantId     String
  customerId   String
  code         String
  rewardStamps Int      @default(1)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  customer    Customer             @relation("Referrer", fields: [customerId], references: [id], onDelete: Cascade)
  tenant      Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  redemptions ReferralRedemption[]

  @@unique([tenantId, code])
  @@index([customerId])
}

model ReferralRedemption {
  id             String   @id @default(cuid())
  tenantId       String
  referralCodeId String
  refereeId      String
  createdAt      DateTime @default(now())

  referralCode ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referee      Customer     @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([referralCodeId, refereeId])
  @@index([tenantId])
}

/// POS entegrasyonu
model PosIntegration {
  id        String   @id @default(cuid())
  tenantId  String
  provider  String
  config    Json     @default("{}")
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  events  PosWebhookEvent[]

  @@index([tenantId, provider])
}

model PosWebhookEvent {
  id            String   @id @default(cuid())
  integrationId String
  externalId    String?
  payload       Json
  status        String   @default("RECEIVED")
  createdAt     DateTime @default(now())

  integration PosIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@unique([integrationId, externalId])
}

/// E-posta şablonları
model EmailTemplate {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  subject   String
  bodyMd    String   @default("")
  bodyJson  Json?
  bodyHtml  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  campaigns EmailCampaign[]

  @@index([tenantId])
}

model EmailCampaign {
  id         String   @id @default(cuid())
  tenantId   String
  templateId String
  segmentId  String?
  status     String   @default("DRAFT")
  sentCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  template EmailTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// Günlük tenant metrikleri
model DailyTenantMetrics {
  id                  String   @id @default(cuid())
  tenantId            String
  date                DateTime @db.Date
  stamps              Int      @default(0)
  redeems             Int      @default(0)
  newCustomers        Int      @default(0)
  pointEarned         Int      @default(0)
  cashbackEarnKurus   Int      @default(0)
  cashbackRedeemKurus Int      @default(0)
  createdAt           DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date])
  @@index([tenantId, date])
}

/// Şube bazlı günlük metrikler (V3)
model BranchDailyMetrics {
  id                  String   @id @default(cuid())
  tenantId            String
  branchId            String
  date                DateTime @db.Date
  stamps              Int      @default(0)
  redeems             Int      @default(0)
  newCustomers        Int      @default(0)
  pointEarned         Int      @default(0)
  cashbackEarnKurus   Int      @default(0)
  cashbackRedeemKurus Int      @default(0)
  createdAt           DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, branchId, date])
  @@index([tenantId, date])
}

/// Sosyal kampanya talepleri
model SocialRewardClaim {
  id           String   @id @default(cuid())
  tenantId     String
  customerId   String
  platform     String
  actionType   String?
  proofUrl     String?
  rewardStamps Int      @default(1)
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
}

/// Enterprise API anahtarları
model TenantApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  label      String
  keyHash    String    @unique
  keyPrefix  String
  isActive   Boolean   @default(true)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

/// Hediye / mağaza kredisi
model GiftCredit {
  id                   String    @id @default(cuid())
  tenantId             String
  code                 String
  amountKurus          Int
  status               String    @default("ACTIVE")
  redeemedByCustomerId String?
  redeemedAt           DateTime?
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, status])
}

// ─── QR Menü ────────────────────────────────────────────────

model MenuCategory {
  id          String   @id @default(cuid())
  tenantId    String
  branchId    String?
  name        String
  nameTr      String?
  nameEn      String?
  description String?
  /// Dil kodu → { name?, description? }
  translations Json?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)
  items  MenuItem[]

  parentId String?
  parent   MenuCategory?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuCategory[] @relation("SubCategories")

  @@index([tenantId])
  @@index([parentId])
  @@index([branchId])
}

model MenuItem {
  id          String   @id @default(cuid())
  categoryId  String
  tenantId    String
  name        String
  nameTr      String?
  nameEn      String?
  description String?
  /// Dil kodu → { name?, description? }
  translations Json?
  price       Decimal  @db.Decimal(10, 2)
  currency    String   @default("TRY")
  imageUrl    String?
  allergens   String[]
  tags        String[]
  variants    Json?
  isAvailable Boolean  @default(true)
  sortOrder   Int      @default(0)
  calories    Int?
  prepTimeMin Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  arAssets MenuItemArAsset[]

  @@index([tenantId])
  @@index([categoryId])
}

model MenuTable {
  id        String   @id @default(cuid())
  tenantId  String
  branchId  String
  label     String
  qrCode    String   @unique @default(cuid())
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, label])
  @@index([tenantId])
  @@index([branchId])
}

model MenuItemArAsset {
  id         String   @id @default(cuid())
  menuItemId String
  assetUrl   String
  format     String
  createdAt  DateTime @default(now())

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId])
}

/// QR menü öneri / şikayet kutusu
model MenuFeedback {
  id         String   @id @default(cuid())
  tenantId   String
  /// suggest | complaint
  type       String
  name       String?
  message    String
  tableLabel String?
  lang       String?
  /// NEW | READ | ARCHIVED
  status     String   @default("NEW")
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
}

/// Ürün etiketleri (tenant bazlı katalog). `label` ana (Türkçe) ad; `translations` dil kodu → { name }.
model MenuTag {
  id           String   @id @default(cuid())
  tenantId     String
  label        String
  translations Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, label])
  @@index([tenantId])
}

/// Alerjen ve ekstra kataloğu (tenant bazlı, çok dilli). kind: "ALLERGEN" | "EXTRA".
/// `label` ana (Türkçe) ad; `translations` dil kodu → { name }. Ekstralarda `defaultPrice` ürüne kopyalanan varsayılan ücret.
model MenuCatalogEntry {
  id           String   @id @default(cuid())
  tenantId     String
  kind         String
  label        String
  translations Json?
  defaultPrice Decimal? @db.Decimal(10, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, label])
  @@index([tenantId])
}

/// Destek talebi — hesabı pasif olan / iletişime geçen işletmeler için takip kodlu kayıt
model SupportTicket {
  id             String   @id @default(cuid())
  code           String   @unique
  /// Hesap eşleştiyse (e-posta ile) ilgili işletme; zorunlu değil
  tenantId       String?
  requesterName  String
  requesterEmail String
  cafe           String
  phone          String?
  subject        String
  /// OPEN | IN_PROGRESS | RESOLVED | CLOSED
  status         String   @default("OPEN")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  messages SupportMessage[]

  @@index([status])
  @@index([requesterEmail])
  @@index([tenantId])
  @@index([createdAt])
}

/// Talep yazışması — OWNER (işletme) veya ADMIN (süper admin)
model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  authorType String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  attachments SupportAttachment[]

  @@index([ticketId, createdAt])
}

/// Yazışmaya eklenen dosya (görsel veya PDF)
model SupportAttachment {
  id        String   @id @default(cuid())
  messageId String
  fileName  String
  mimeType  String
  sizeBytes Int
  url       String
  createdAt DateTime @default(now())

  message SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
}

/// Kısa davet linki: /wallet/i/{code} → süresi dolana kadar müşteri davet sayfasına açılır
model WalletShortLink {
  id         String   @id @default(cuid())
  code       String   @unique
  tenantId   String
  customerId String
  programIds Json?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([tenantId])
  @@index([customerId])
}

/// Sahibin yüklediği görseller (davet sayfası, kampanya vb.) — yeniden seçilebilir
model TenantMedia {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  mimeType  String
  sizeBytes Int
  createdAt DateTime @default(now())

  @@index([tenantId, createdAt])
}

