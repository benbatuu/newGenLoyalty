# Database
DATABASE_URL="postgresql://ngl@127.0.0.1:5433/ngl?schema=public"

# API
API_PORT=3001
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App URLs
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"
API_URL="http://localhost:3001"
# Admin / web clients
# NEXT_PUBLIC_API_URL="http://localhost:3001"
# NEXT_PUBLIC_ADMIN_URL="http://localhost:3002"
# Password reset: return resetUrl in API response (dev/pilot). Prod: set false + SMTP.
EXPOSE_RESET_URL="true"
# Apple Wallet live updates require HTTPS. Set a tunnel URL, e.g.:
# APPLE_WEB_SERVICE_URL="https://xxxx.trycloudflare.com"
APPLE_WEB_SERVICE_URL=""

# SMS — https://www.toplusmsapi.com/
# SMS_PROVIDER=mock | iletimerkezi
SMS_PROVIDER="mock"
SMS_API_USER=""
SMS_API_PASS=""
# Onaylı gönderici başlığı (max 11) veya APITEST — telefon numarası yazma
SMS_SENDER="APITEST"
SMS_IYS="0"
# Panel Bildirim Adresi: https://API/webhooks/iletimerkezi?token=...
SMS_WEBHOOK_TOKEN=""

# Apple Wallet / PassKit
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_PASS_CERT_PATH=""
APPLE_PASS_KEY_PATH=""
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT_PATH=""

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY_PATH=""
