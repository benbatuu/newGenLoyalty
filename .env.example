# Database
DATABASE_URL="postgresql://ngl@127.0.0.1:5433/ngl?schema=public"

# API
API_PORT=3001
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# App URLs (local defaults)
WEB_URL="http://localhost:3000"
ADMIN_URL="http://localhost:3002"
API_URL="http://localhost:3001"
# Vercel admin: only API_URL (Runtime is enough) — browser uses /backend proxy
# Vercel web: API_URL + ADMIN_URL + WEB_URL (Build + Runtime; next.config maps to client)
#   API_URL=https://newgenloyalty.onrender.com
#   ADMIN_URL=https://your-admin.vercel.app
#   WEB_URL=https://your-web.vercel.app
# Render API: ADMIN_URL / WEB_URL / API_URL = production https domains.
# Password reset: return resetUrl in API response (dev/pilot). Prod: set false + SMTP.
EXPOSE_RESET_URL="true"
# Apple Wallet live updates require HTTPS. Set a tunnel URL, e.g.:
# APPLE_WEB_SERVICE_URL="https://xxxx.trycloudflare.com"
APPLE_WEB_SERVICE_URL=""

# SMS — mock | twilio | iletimerkezi
SMS_PROVIDER="mock"
# Twilio (TR + tourist international numbers)
# TWILIO_ACCOUNT_SID=ACxxxxxxxx   # MUST start with AC (not SK)
# TWILIO_AUTH_TOKEN=…
# OR API key:
# TWILIO_API_KEY_SID=SKxxxxxxxx
# TWILIO_API_KEY_SECRET=…
# TWILIO_FROM=+1xxxxxxxx
# TWILIO_MESSAGING_SERVICE_SID=MGxxxx
# Status callback: https://API/webhooks/twilio?token=SMS_WEBHOOK_TOKEN
# Legacy TR (iletiMerkezi):
SMS_API_USER=""
SMS_API_PASS=""
SMS_SENDER="APITEST"
SMS_IYS="0"
SMS_WEBHOOK_TOKEN=""

# Apple / Google Wallet — path, /etc/secrets, /tmp/ngl-certs, OR *_B64 env
APPLE_PASS_TYPE_ID=""
APPLE_TEAM_ID=""
APPLE_PASS_CERT_PATH=""
APPLE_PASS_KEY_PATH=""
APPLE_PASS_KEY_PASSPHRASE=""
APPLE_WWDR_CERT_PATH=""
# Render B64 (preferred if Secret Files awkward): openssl base64 -A -in certs/xxx.pem
# APPLE_PASS_CERT_B64=
# APPLE_PASS_KEY_B64=
# APPLE_WWDR_CERT_B64=
# GOOGLE_WALLET_SA_B64=

# Google Wallet
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY_PATH=""

# Cloudflare R2 — private bucket; API serves files at /media/tenants/...
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=ngl-assets
# Optional (only if r2.dev / custom domain public access is ON):
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
# R2_USE_PUBLIC_URL=true
