{
  "name": "new-gen-loyalty",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm run \"/^dev:(api|web|admin)$/\"",
    "dev:api": "pnpm --filter @ngl/api start:dev",
    "dev:web": "pnpm --filter @ngl/web dev",
    "dev:admin": "pnpm --filter @ngl/admin dev",
    "build": "pnpm -r --filter \"@ngl/*\" build",
    "lint": "pnpm -r --filter \"@ngl/*\" lint",
    "sync:mobile-shared": "node scripts/sync-shared-mobile.mjs",
    "verify:prod-env": "node scripts/verify-prod-env.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
